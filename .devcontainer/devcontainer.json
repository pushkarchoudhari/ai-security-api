{
  "name": "ai-security-api",

  // Python 3.12 on Debian, matching the version CI and the production image use.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "features": {
    // Gives the container its own Docker daemon, so `docker build`,
    // `docker run` and `docker compose` all work inside the Codespace.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Installs the project and its dev tooling once, when the Codespace is built.
  "postCreateCommand": "python -m pip install --upgrade pip && pip install -e '.[dev]'",

  // Prints the available commands the first time a terminal attaches.
  "postAttachCommand": {
    "welcome": "bash .devcontainer/welcome.sh"
  },

  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "AI Security API",
      "onAutoForward": "notify"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "editor.formatOnSave": false
      }
    }
  },

  "remoteUser": "vscode"
}

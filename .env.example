# Copy to .env and adjust. Every value below has a safe default; the app runs
# with no .env at all.

# --- LLM ---------------------------------------------------------------------
# mock = deterministic keyword classifier, no network, no cost (default)
# live = Google Gemini, requires GEMINI_API_KEY
LLM_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Hard ceiling on live model calls per process. Exhausting it degrades to the
# deterministic classifier rather than failing requests or draining a quota.
LLM_DAILY_CALL_BUDGET=500

# --- Security ----------------------------------------------------------------
# Injected into the system prompt; if it appears in model output, the prompt
# leaked. Leave unset to generate a fresh random token per process.
# CANARY_TOKEN=

# Injection risk score at or above which a request is blocked (0-100+ scale).
INJECTION_RISK_THRESHOLD=70

RATE_LIMIT=10/minute

# Only enable behind a proxy you control (Fly.io, an ALB, nginx). On a directly
# exposed service, X-Forwarded-For is caller-controlled and forging it would
# bypass rate limiting entirely.
TRUST_PROXY_HEADERS=false

# --- Audit -------------------------------------------------------------------
AUDIT_LOG_PATH=audit.log
AUDIT_LOG_TO_CONSOLE=true

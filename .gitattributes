# Normalise line endings in the repository to LF. Development happens on
# Windows, CI and the container run on Linux -- without this, every file
# touched on Windows shows as wholly rewritten in the diff.
* text=auto

# Files consumed by Linux tooling must be LF in the working tree too.
*.sh        text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
